  "organizationPrivacyTitle": "Choose what to hide from AI",
  "organizationPrivacyHint": "Highlighted text stays on this device. People are initially selected according to AI settings; you can unhide or hide each occurrence. Images and attachments are not sent.",
  "organizationStart": "Start organizing",
  "organizationNeedsText": "Leave some text visible for AI to organize.",
  "organizationEditDraft": "Edit draft",
